{
  "name": "@sdd/api",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "nest start --watch",
    "start": "nest start",
    "start:docker": "pnpm db:migrate && node -r ts-node/register/transpile-only -r tsconfig-paths/register src/main.ts",
    "build": "nest build -p tsconfig.build.json",
    "worker": "node -r ts-node/register/transpile-only -r tsconfig-paths/register src/worker.ts",
    "worker:once": "node -r ts-node/register/transpile-only -r tsconfig-paths/register src/worker.ts --once",
    "db:migrate": "tsx src/shared/database/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "test": "vitest run",
    "lint": "node --max-old-space-size=4096 ../../node_modules/typescript/bin/tsc -p tsconfig.typecheck.json --noEmit",
    "typecheck": "node --max-old-space-size=4096 ../../node_modules/typescript/bin/tsc -p tsconfig.typecheck.json --noEmit"
  },
  "dependencies": {
    "@langchain/core": "^0.3.79",
    "@langchain/openai": "^0.6.9",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@sdd/domain": "workspace:*",
    "@sdd/llm-contracts": "workspace:*",
    "@sdd/schemas": "workspace:*",
    "@sdd/spec-format": "workspace:*",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "drizzle-orm": "^0.45.2",
    "jszip": "^3.10.1",
    "postgres": "^3.4.9",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/node": "^24.0.0",
    "drizzle-kit": "^0.31.10",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.20.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.0",
    "@types/ws": "^8.18.1"
  }
}
