{
  "name": "sdd-ai-company",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "pnpm --parallel --filter @sdd/api --filter @sdd/web dev",
    "dev:api": "pnpm --filter @sdd/api dev",
    "dev:web": "pnpm --filter @sdd/web dev",
    "worker": "pnpm --filter @sdd/api worker",
    "start:docker": "pnpm --filter @sdd/api start:docker",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @sdd/api db:generate",
    "db:migrate": "pnpm --filter @sdd/api db:migrate"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.0"
  }
}
